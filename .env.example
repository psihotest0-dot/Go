DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable"
LLM_BASE_URL="http://localhost:13305/v1"
EMBEDDER_URL="http://localhost:8000"

# Disposable database for integration tests. NEVER point this at the database
# above: the tests delete users and drop tables. The database name must contain
# "test" or the tests refuse to run.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/app_test?sslmode=disable"

# Backup location and retention used by scripts/backup.sh (defaults: ./backups, 14).
# BACKUP_DIR="D:/backups/go-monolith"
# BACKUP_KEEP="30"

# Everything below is optional. An empty value means the default shown in the
# comment; README.md ("Configuration") explains each one.

# --- Server ---
# Address of the API (default 127.0.0.1:8080). Keep it on loopback: identity is a
# bare X-User-ID header and /metrics has no authentication.
LISTEN_ADDR=""
# Upload size limit in MB (default 100).
MAX_UPLOAD_MB=""
# Apply pending database migrations at start (default true). With false the start
# fails when the database is behind; run `go run ./cmd/migrate` after a backup.
AUTO_MIGRATE=""
# Directory of prompt templates that override the built-in ones (default: none).
PROMPTS_DIR=""

# --- LLM (Lemonade) ---
# Pin the model name; empty = ask the server which model it serves.
LLM_MODEL=""
# "lemonade" replaces any other model name with the pinned/discovered one.
LLM_PROVIDER=""
# Parallel completions of the model server (default 2) and the share background
# work may use (default 1).
LLM_SLOTS=""
LLM_BACKGROUND_SLOTS=""
# Context window of ONE request = server context / slots, e.g. 16384 for a 32k
# server with two slots. Empty = unknown, the agent keeps conservative budgets.
LLM_CONTEXT_TOKENS=""
# Single budgets, derived from LLM_CONTEXT_TOKENS when empty.
LLM_ANSWER_TOKENS=""
LLM_PROMPT_CONTEXT_TOKENS=""
LLM_HISTORY_TOKENS=""
LLM_HISTORY_MESSAGES=""
LLM_TOOL_RESULT_TOKENS=""
# Let the model reason before it answers (default true).
LLM_ENABLE_THINKING=""
# Skip retrieval for messages that obviously do not need it (default true) and
# write concept summaries of ingested files in the background (default true).
ENABLE_ADAPTIVE_SKIP=""
ENABLE_DISTILLATION=""

# --- Embedder ---
# Limit of one call to the embedding service, in seconds (default 30).
EMBEDDER_TIMEOUT_SECONDS=""

# --- Telegram ---
# The bot starts when the token is set and answers NOBODY until the chat ids it
# may talk to are listed (comma separated). Write /id to the bot to learn yours.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""

# --- PDF and OCR ---
# Poppler executables; empty = an installed Poppler (C:\poppler*\Library\bin on
# Windows) or the one in PATH. Git for Windows ships Xpdf's pdftotext, which is a
# different program: set these if Poppler lives somewhere else.
PDFTOTEXT_PATH=""
PDFTOPPM_PATH=""
PDFINFO_PATH=""
# Resolution (default 250) and pages recognized at once (default 6) for scans.
OCR_DPI=""
OCR_CONCURRENCY=""

# Security Note:
# The user_id context tracing is critical for tenant isolation and must be securely validated.
# The /metrics endpoint is exposed unauthenticated by default. Ensure it is protected via network or firewall rules in production.
# Key of the paid search service behind web_search / web_fetch; without it they are off.
DEEPSEEK_API_KEY=""

# Admin password of the Grafana container (docker-compose.yml refuses to start without it).
# Grafana reads it only when it creates its database, i.e. on a fresh container.
GRAFANA_ADMIN_PASSWORD=""
