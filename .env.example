DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable"
LLM_BASE_URL="http://localhost:13305/v1"
EMBEDDER_URL="http://localhost:8000"

# Disposable database for integration tests. NEVER point this at the database
# above: the tests delete users and drop tables. The database name must contain
# "test" or the tests refuse to run.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/app_test?sslmode=disable"

# Backup location and retention used by scripts/backup.sh (defaults: ./backups, 14).
# BACKUP_DIR is also the folder the `backup` compose service writes to (dumps in its `auto`
# subfolder, the uploaded files in `storage`). Use a folder outside the repository and outside
# OneDrive; on Windows write it with forward slashes.
# BACKUP_DIR="D:/backups/go-monolith"
# BACKUP_KEEP="30"

# The `backup` compose service (docker-compose.override.yml, scripts/db-backup-loop.sh).
# Seconds between rounds (default 21600 = 6 h), how many quick dumps (without
# embedding_cache, ~250 MB each) and how many full dumps (~470 MB, about one a day) to keep
# (defaults 12 and 7), and the time zone of the file names and the log (default UTC; use the
# zone of the PC, e.g. Europe/Berlin for "W. Europe Standard Time").
# DB_BACKUP_INTERVAL_SECONDS=21600
# DB_BACKUP_KEEP=12
# DB_BACKUP_KEEP_FULL=7
# TZ=Europe/Berlin

# Everything below is optional. An empty value means the default shown in the
# comment; README.md ("Configuration") explains each one.

# --- Server ---
# Address of the API (default 127.0.0.1:8080). Keep it on loopback: identity is a
# bare X-User-ID header and /metrics has no authentication.
LISTEN_ADDR=""
# Upload size limit in MB (default 100).
MAX_UPLOAD_MB=""
# Apply pending database migrations at start (default true). With false the start
# fails when the database is behind; run `go run ./cmd/migrate` after a backup.
AUTO_MIGRATE=""
# Directory of prompt templates that override the built-in ones (default: none).
PROMPTS_DIR=""
# Size in MB at which backend.log is rotated; the old file is compressed and kept as
# one backup (default 10).
LOG_MAX_MB=""
# metrics.log holds only the "incoming request" lines of the polling: the Prometheus
# scrapes (GET /metrics, every 15 s) and the client's reads of the Oracle journal
# (GET /oracle/decisions, every 10 s while the "Бот" tab is open) and the bot's
# availability pings (GET /oracle/ping). It is emptied when
# it reaches this size, no backup (default 5).
METRICS_LOG_MAX_MB=""
# The assistant's own text files (notes, lists, drafts it writes down on request). Off by
# default: without FILES_ENABLED=true nothing changes. FILES_DIR is an absolute path of
# a folder that is NOT synchronised to a cloud (default: Lili-files in the home folder);
# each user gets a flat folder of their own in it. See FILES_ENABLED in the README.
FILES_ENABLED=""
FILES_DIR=""
# The tool add_to_library: the assistant downloads the PDFs and articles behind links
# you wrote in the conversation and adds them to the library. Off by default: without
# LIBRARY_ADD_ENABLED=true nothing changes. See LIBRARY_ADD_ENABLED in the README.
# web_fetch of the chat from this machine: a page or a PDF is read here (the address of every
# connection checked, the size bounded, a PDF without OCR), and the paid API only when that gives
# nothing (a site that refuses programs). Measured on 25 public pages: 19 read instead of 16, both
# PDFs (the paid API reads none), ~60% fewer paid calls. Off by default: without
# WEB_FETCH_LOCAL_ENABLED=true nothing changes. See the README.
WEB_FETCH_LOCAL_ENABLED=""
LIBRARY_ADD_ENABLED=""
# The plan of an answer to a personal message ("уморен съм"): the code picks 1-3 of the
# person's memories and the model weaves them into a short reply. Off by default: without
# ANSWER_PLAN_ENABLED=true nothing changes. Needs migration 36. See the README.
ANSWER_PLAN_ENABLED=""
# Themes for the memories: every five minutes the local model gives up to ten memories a few
# theme words ("умора", "почивка", "вечер") and their vector is made from "themes: memory", so
# that the search finds a memory for a mood. Off by default: without MEMORY_THEMES_ENABLED=true
# no memory gets themes and nothing changes. See the README.
MEMORY_THEMES_ENABLED=""
# The lean chat prompt: without the tone examples and the repeated description of the tools
# and the web, and without the tool for attached files when nothing is attached (~1130 tokens
# less; measured better on the tool cases and the same in a blind test of the tone). Off by
# default: without LEAN_PROMPT_ENABLED=true nothing changes. See the README.
LEAN_PROMPT_ENABLED=""
# The memories and the book summaries of a turn after the history, in a system message of their own
# right before the person's message, so that the model server reuses the start of the prompt
# (measured: the local model 26% -> 56% of the prompt from its cache, DeepSeek 62% -> 88%). Off by
# default: without CONTEXT_AFTER_HISTORY_ENABLED=true nothing changes. See the README.
CONTEXT_AFTER_HISTORY_ENABLED=""
# The explanation from the library: for "не разбирам X" / "обясни ми X" the code gathers the
# passages (nine searches, at most two passages of a book, the text around the best three) and
# the model writes the explanation from them. Off by default: without
# EXPLAIN_DOSSIER_ENABLED=true nothing changes. See the README.
EXPLAIN_DOSSIER_ENABLED=""
# Which model writes such an explanation: empty or local - the local one (even though it is a
# library question); deepseek - the paid one (needs PAID_LLM_ENABLED=true). The "cloud" and
# "home" button of a conversation in the client decides first. Anything else stops the start.
EXPLAIN_LLM=""
# "Успя ли?" from the code: a short question about the work after a request about the files (or
# with a plan of a task in progress) is answered by the server from the folder - which files
# changed since the request, with their times and sizes, or that none did - and the model is not
# asked. Off by default: without STATUS_ANSWER_ENABLED=true nothing changes. See the README.
STATUS_ANSWER_ENABLED=""
# Keep the uploaded file in the storage folder after a successful ingest (default
# true). It is only needed to ingest the file again (cmd/reingest); search and
# chat use the database. With false it is deleted once its text and vectors are
# stored; a failed ingest keeps it. Needs a restart of the backend.
KEEP_ORIGINALS=""

# --- LLM (Lemonade) ---
# Pin the model name; empty = ask the server which model it serves.
LLM_MODEL=""
# "lemonade" replaces any other model name with the pinned/discovered one.
LLM_PROVIDER=""
# Parallel completions of the model server (default 2) and the share background
# work may use (default 1).
LLM_SLOTS=""
LLM_BACKGROUND_SLOTS=""
# Context window of ONE request = server context / slots, e.g. 16384 for a 32k
# server with two slots. Empty = unknown, the agent keeps conservative budgets.
LLM_CONTEXT_TOKENS=""
# Single budgets, derived from LLM_CONTEXT_TOKENS when empty.
LLM_ANSWER_TOKENS=""
LLM_PROMPT_CONTEXT_TOKENS=""
LLM_HISTORY_TOKENS=""
LLM_HISTORY_MESSAGES=""
LLM_TOOL_RESULT_TOKENS=""
# Let the model reason before it answers (default false).
LLM_ENABLE_THINKING=""
# Sampling for chat requests. Defaults: temperature 0.7 (0-2), top_p 0.8 (0.01-1),
# presence penalty 0 = not sent (0-2). They override what the model server was
# started with (Lemonade's Qwen 3.5 defaults are temperature 1.0, top_p 0.95).
LLM_TEMPERATURE=""
LLM_TOP_P=""
LLM_PRESENCE_PENALTY=""
# Skip retrieval for messages that obviously do not need it (default true) and
# write concept summaries of ingested files in the background (default true).
ENABLE_ADAPTIVE_SKIP=""
ENABLE_DISTILLATION=""

# --- Embedder ---
# Limit of one call to the embedding service, in seconds (default 30).
EMBEDDER_TIMEOUT_SECONDS=""

# --- Telegram ---
# The bot starts when the token is set and answers NOBODY until the chat ids it
# may talk to are listed (comma separated). Write /id to the bot to learn yours.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""
# "local" keeps every Telegram turn on the local model, even a question to the library (which
# otherwise goes to the paid model when PAID_LLM_ENABLED=true). Empty or "auto": the router decides.
TELEGRAM_LLM=""
# Optional: send the Prometheus alerts to another chat than the first of the list above
# (read only by scripts/alertmanager-secrets.ps1, which writes the files Alertmanager uses).
# ALERT_TELEGRAM_CHAT_ID=""

# --- Oracle (the trading bot's second opinion) ---
# Bearer token of POST /oracle/evaluate and GET /oracle/ping, which the trading bot
# calls. Empty, or shorter than 32 characters: those routes are not served at all.
# The same value goes into the bot's .env. Make one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
ORACLE_TOKEN=""
# The master switch of the paid model (DeepSeek). false: everything stays on the local
# model. true: the Oracle asks DeepSeek (needs DEEPSEEK_API_KEY below). The bot's judge
# starts a new period when the model changes - switch only when that is wanted. See
# "The Oracle on DeepSeek" in the README.
PAID_LLM_ENABLED=false
# The most the paid model may cost in a local day (dollars, at the peak prices). At it the
# Oracle answers HOLD until midnight.
PAID_LLM_DAILY_USD=1.0
# local keeps the Oracle on the local model even when PAID_LLM_ENABLED=true; empty follows the switch.
# Put local here while the bot's judge is on its first period and the chat should use the cloud.
ORACLE_LLM=""
# local keeps the questions to the library on the local model even when PAID_LLM_ENABLED=true;
# empty follows the switch. The "cloud" button of the client works whatever this says.
LIBRARY_LLM=""
# The model the chat uses at the paid provider; empty is deepseek-flash.
PAID_LLM_MODEL=""
# How often a reply of the chat ends with a question: every this-many-th reply of a conversation
# (4 = one of four); the others end with a statement. 0 puts the dose off.
CHAT_QUESTION_EVERY=4
# The model at the paid provider; empty is deepseek-flash (deepseek-v4-pro is dearer).
ORACLE_LLM_MODEL=""

# --- PDF and OCR ---
# Poppler executables; empty = an installed Poppler (C:\poppler*\Library\bin on
# Windows) or the one in PATH. Git for Windows ships Xpdf's pdftotext, which is a
# different program: set these if Poppler lives somewhere else. Tesseract has no
# setting: `tesseract` must be in PATH (see "Poppler and Tesseract on Windows" in
# the README).
PDFTOTEXT_PATH=""
PDFTOPPM_PATH=""
PDFINFO_PATH=""
# Resolution (default 250) and pages recognized at once (default 6) for scans.
OCR_DPI=""
OCR_CONCURRENCY=""

# Security Note:
# The user_id context tracing is critical for tenant isolation and must be securely validated.
# The /metrics endpoint is exposed unauthenticated by default. Ensure it is protected via network or firewall rules in production.
# Key of the paid search service behind web_search / web_fetch; without it they are off.
DEEPSEEK_API_KEY=""

# Admin password of the Grafana container (docker-compose.yml refuses to start without it).
# Grafana reads it only when it creates its database, i.e. on a fresh container.
GRAFANA_ADMIN_PASSWORD=""
